<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.scene.control.Button?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.control.Menu?>
        <?import javafx.scene.control.MenuBar?>
        <?import javafx.scene.control.MenuItem?>
        <?import javafx.scene.control.TableColumn?>
        <?import javafx.scene.control.TableView?>
        <?import javafx.scene.control.TextField?>
        <?import javafx.scene.control.ToolBar?>
        <?import javafx.scene.layout.BorderPane?>
        <?import javafx.scene.layout.HBox?>
        <?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="uamv.edu.ni.tiendaartesanias.controllers.CatalogoController">

    <top>
        <VBox>

            <MenuBar>

                <Menu text="Catálogo">
                    <MenuItem text="Mostrar catálogo"
                              onAction="#menuCatalogo"/>
                </Menu>

                <Menu text="Ventas">
                    <MenuItem text="Ventas"
                              onAction="#menuVentas"/>
                </Menu>

                <Menu text="Ayuda">
                    <MenuItem text="Acerca de"
                              onAction="#menuAyuda"/>
                </Menu>

            </MenuBar>

            <ToolBar>

                <Button text="Nuevo"
                        onAction="#nuevo"/>

                <Button text="Guardar"
                        onAction="#guardar"/>

                <Label text="Buscar:"/>

                <TextField fx:id="txtBuscar"
                           promptText="Nombre o categoría"/>

                <Button text="Buscar"
                        onAction="#buscar"/>

            </ToolBar>

        </VBox>
    </top>

    <center>

        <VBox spacing="10">

            <HBox spacing="10">

                <TextField fx:id="txtNombre"
                           promptText="Nombre del producto"/>

                <TextField fx:id="txtCategoria"
                           promptText="Categoría"/>

                <TextField fx:id="txtPrecio"
                           promptText="Precio"/>

            </HBox>

            <TableView fx:id="tablaCatalogo"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colNombre"
                                 text="Nombre"
                                 prefWidth="200"/>

                    <TableColumn fx:id="colCategoria"
                                 text="Categoría"
                                 prefWidth="160"/>

                    <TableColumn fx:id="colPrecio"
                                 text="Precio"
                                 prefWidth="100"/>

                    <TableColumn fx:id="colImagen"
                                 text="Imagen"
                                 prefWidth="150"/>

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>

