<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="650.0" prefWidth="1050.0" spacing="0"
      style="-fx-background-color: #F5F5DC;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.ejercicio2.HelloController">

    <!-- Styles CSS Incrustados -->
    <style>
        .table-view {
        -fx-background-color: transparent;
        -fx-base: #F5F5DC;
        -fx-control-inner-background: #FFFFFF;
        }
        .table-view .column-header-background {
        -fx-background-color: #2C1A1D;
        }
        .table-view .column-header, .table-view .filler {
        -fx-background-color: transparent;
        -fx-size: 40px;
        }
        .table-view .column-header .label {
        -fx-text-fill: #FFFFFF;
        -fx-font-weight: bold;
        -fx-font-size: 11px;
        }
        .table-row-cell {
        -fx-background-color: #FFFFFF;
        -fx-border-color: #F5F5DC;
        -fx-border-width: 0 0 1 0;
        }
        .table-row-cell:odd {
        -fx-background-color: #FAF9F0;
        }
        .table-row-cell:selected {
        -fx-background-color: #E8E3D3;
        }
        .btn-principal {
        -fx-background-color: #6F4E37;
        -fx-text-fill: white;
        -fx-font-weight: bold;
        -fx-background-radius: 5;
        -fx-cursor: hand;
        -fx-padding: 8 15 8 15;
        }
        .btn-principal:hover {
        -fx-background-color: #A0522D;
        }
    </style>

    <!-- Header / Navbar Top -->
    <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: #2C1A1D;">
        <padding>
            <Insets bottom="0.0" left="20.0" right="20.0" top="0.0" />
        </padding>
        <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
            <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 18px; -fx-font-weight: bold;" text="☕ Cooperativa Cafetera" />
            <Label style="-fx-text-fill: #A0522D; -fx-font-size: 11px;" text="Recepción de Lotes - 2026" />
        </VBox>
        <Button onAction="#handleAgregarLote" styleClass="btn-principal" text="+ Agregar Lote" />
    </HBox>

    <!-- Panel de Métricas / Resumen -->
    <HBox spacing="30.0" style="-fx-background-color: #EFE8D5; -fx-border-color: #DCD5C0; -fx-border-width: 0 0 1 0;">
        <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
        </padding>
        <VBox spacing="2">
            <Label style="-fx-text-fill: #6F4E37; -fx-font-size: 10px; -fx-font-weight: bold;" text="LOTES REGISTRADOS" />
            <Label fx:id="lblTotalLotes" style="-fx-text-fill: #2C1A1D; -fx-font-size: 20px; -fx-font-weight: bold;" text="0" />
        </VBox>
        <VBox spacing="2">
            <Label style="-fx-text-fill: #81B29A; -fx-font-size: 10px; -fx-font-weight: bold;" text="APROBADOS" />
            <Label fx:id="lblAprobados" style="-fx-text-fill: #81B29A; -fx-font-size: 20px; -fx-font-weight: bold;" text="0" />
        </VBox>
        <VBox spacing="2">
            <Label style="-fx-text-fill: #6F4E37; -fx-font-size: 10px; -fx-font-weight: bold;" text="PESO TOTAL" />
            <Label fx:id="lblPesoTotal" style="-fx-text-fill: #2C1A1D; -fx-font-size: 20px; -fx-font-weight: bold;" text="0 kg" />
        </VBox>
        <VBox spacing="2">
            <Label style="-fx-text-fill: #E07A5F; -fx-font-size: 10px; -fx-font-weight: bold;" text="EN REVISIÓN" />
            <Label fx:id="lblEnRevision" style="-fx-text-fill: #E07A5F; -fx-font-size: 20px; -fx-font-weight: bold;" text="0" />
        </VBox>
    </HBox>

    <!-- Tabla Principal de Lotes -->
    <TableView fx:id="tablaLotes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="100.0" text="ID LOTE" />
            <TableColumn fx:id="colProductor" prefWidth="180.0" text="PRODUCTOR" />
            <TableColumn fx:id="colFinca" prefWidth="140.0" text="FINCA" />
            <TableColumn fx:id="colVariedad" prefWidth="100.0" text="VARIEDAD" />
            <TableColumn fx:id="colPeso" prefWidth="90.0" text="PESO (KG)" />
            <TableColumn fx:id="colFecha" prefWidth="120.0" text="FECHA ENTREGA" />
            <TableColumn fx:id="colEstado" prefWidth="120.0" text="ESTADO" />
            <TableColumn fx:id="colHumedad" prefWidth="100.0" text="HUMEDAD %" />
            <TableColumn fx:id="colAltitud" prefWidth="100.0" text="ALTITUD MSNM" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <!-- Footer / Barra de Estado -->
    <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #EFE8D5;">
        <padding>
            <Insets bottom="8.0" left="20.0" right="20.0" top="8.0" />
        </padding>
        <Label style="-fx-text-fill: #A0522D; -fx-font-size: 11px;" text="💡 Doble clic para ver detalles del lote" />
        <Label style="-fx-text-fill: #A0522D; -fx-font-size: 11px;" text="🖱️ Clic derecho para opciones (Editar/Eliminar)" />
    </HBox>
</VBox>